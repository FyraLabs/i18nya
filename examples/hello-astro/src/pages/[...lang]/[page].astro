---
import { makeGetStaticPaths } from "astro-i18nya";
import i18nya, { makeT } from "../../i18n.ts";

export const getStaticPaths = makeGetStaticPaths(
  i18nya,
  ["foo", "bar", "baz"].map((page) => ({ params: { page } })),
);

const lang = Astro.params.lang ?? i18nya.config.defaultLang;
const t = makeT(lang);
---

<html lang={lang.replaceAll("_", "-")}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro</title>
	</head>
	<body>
		<h1>Astro</h1>
		<h2>{t("hello")}</h2>
		<h3>{t("page", { page: Astro.params.page! })}</h3>
	</body>
</html>
